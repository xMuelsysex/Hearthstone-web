{
  "compilerOptions": {
    "tsBuildInfoFile": "./.artifacts/tsbuildinfo/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.browser.config.ts",
    "playwright.config.ts",
    "eslint.config.js"
  ]
}
